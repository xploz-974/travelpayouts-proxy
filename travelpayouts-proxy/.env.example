PORT=3001

# https://app.travelpayouts.com/dashboard -> Outils > API
TRAVELPAYOUTS_TOKEN=colle_ton_token_ici

# https://duffel.com -> Dashboard -> Access tokens (token de TEST)
DUFFEL_API_KEY=

# Nécessite un accès partenaire Booking.com approuvé (partnerships.booking.com)
BOOKING_AFFILIATE_ID=
BOOKING_API_TOKEN=
BOOKING_ENV=sandbox

# Sauvegarde cloud (Cloudflare R2, compatible S3) — cloudflare.com/products/r2
# Compte R2 -> Manage R2 API Tokens -> Create API Token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Assistant IA (lecture de passeport/reçu, conseils pays, questions libres)
# https://aistudio.google.com/app/api-keys -> Create API key
GEMINI_API_KEY=

# Recherche Google Hotels (onglet Hébergements) — plan gratuit limité en
# recherches/mois, voir ton quota sur https://serpapi.com/manage-api-key
SERPAPI_KEY=
